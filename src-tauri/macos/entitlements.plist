<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copyright (C) 2026 SkapaCraft <https://skapacraft.com>
  SPDX-License-Identifier: GPL-3.0-or-later

  App Sandbox entitlements for the Mac App Store build. Two capabilities,
  because two are all the application uses:

  - app-sandbox is mandatory for Mac App Store distribution.
  - files.user-selected.read-write covers every file access the app makes:
    the Takeout source and the destination for repaired copies both come
    from the system's own Open/Save panel, never from a path the app
    guesses or remembers. No app-scoped bookmark entitlement is requested
    because no path is kept past the session that chose it.

  No network entitlement. That omission is not a placeholder to fill in
  later, it is the sandbox enforcing at the OS level the same constraint
  the build already enforces in the dependency graph: this application
  cannot open a connection even if something in it tried to.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
